# =============================================================================
# Test Data Simulator — Environment Configuration
# =============================================================================
# Copy this file to .env and configure your desired provider and settings.
# All credentials are loaded exclusively from this backend environment.
# =============================================================================

# --- Application ---
APP_NAME="Agentic Test Data Simulator"
DEBUG=false

# --- Database ---
# SQLite (default):
DATABASE_URL=sqlite:///./tdm.db
# PostgreSQL (example):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tdm

# --- LLM Provider Selection ---
# Options:
#   - openai (default, e.g. gpt-4o, gpt-4o-mini)
#   - gemini (e.g. gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash)
#   - anthropic (e.g. claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022)
#   - groq (e.g. llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768)
#   - openrouter (e.g. meta-llama/llama-3.3-70b-instruct, anthropic/claude-3.5-sonnet, deepseek/deepseek-chat)
#   - deepseek (e.g. deepseek-chat, deepseek-coder)
#   - mistral (e.g. mistral-large-latest, codestral-latest)
#   - ollama (e.g. llama3.1:latest, qwen2.5-coder)
#   - azure_openai (Azure deployed OpenAI models)
#   - local (OpenAI-compatible endpoints like LM Studio, vLLM, LocalAI)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8192

# --- Provider API Keys & Base URLs ---
# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
GOOGLE_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Mistral AI
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Ollama / Local / Custom OpenAI-Compatible
OLLAMA_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
CUSTOM_BASE_URL=

# Azure OpenAI (if using azure_openai)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=

# --- Generation Limits & Parameters ---
MAX_RECORDS_PER_REQUEST=10000
MAX_RETRIES=3
BATCH_SIZE=50

# --- Export Settings ---
EXPORT_DIR=exports
MAX_EXPORT_FILE_SIZE_MB=100

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
